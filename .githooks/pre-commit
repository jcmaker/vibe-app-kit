#!/bin/sh
# 커밋 가드레일. 켜는 법: git config core.hooksPath .githooks

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
case "$branch" in
  main|dev)
    echo "$branch 브랜치에는 직접 커밋할 수 없습니다."
    echo "작업 브랜치를 만들어 주세요: git switch dev && git pull && git switch -c 영문이름/작업-요약"
    exit 1 ;;
esac

exec sh scripts/guard.sh staged
